# Supabase (Project Settings -> API Keys). Use the publishable key only; never a secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public site URL (used for auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set once the repository exists. While empty, "Report a Bug on GitHub" and
# "Contribute on GitHub" show as unavailable (bug reports still save to the platform).
NEXT_PUBLIC_GITHUB_REPO_URL=

# Optional: a Discord profile or invite URL for the Developer page. Left out when empty.
NEXT_PUBLIC_DISCORD_URL=
